PORT=3003
MOCK_MODE=false
# UserPlatform integration (server-only; no VITE_ secrets, never commit real token)
# USER_PLATFORM_URL=https://user-platform-phi.vercel.app
# USER_PLATFORM_SERVICE_TOKEN=
# PLATFORM_INTEGRATION_ENABLED=false
# PLATFORM_SESSION_COOKIE_NAME=wardrobe_session
# Wardrobe database (own schema only; never UserPlatform tables)
# DATABASE_URL=postgresql://postgres:<db-password>@db.<ref>.supabase.co:5432/postgres
# Anonymous prototype limits (per 24h UTC bucket)
# VISION_DEVICE_DAILY_LIMIT=5
# VISION_IP_DAILY_LIMIT=20
# Authenticated abuse caps (credits remain the business entitlement)
# AUTH_VISION_USER_DAILY_LIMIT=30
# AUTH_VISION_IP_DAILY_LIMIT=200
# Production rate-limit store (Upstash Redis REST or Vercel KV). Dev/tests use memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
